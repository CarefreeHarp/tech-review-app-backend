            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"articleId\": 1,\n  \"rating\": 5,\n  \"title\": \"Reseña de prueba\",\n  \"body\": \"Buena experiencia con el producto.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "  const review = pm.response.json();",
                  "  pm.test(\"Usuario, artículo y contenido enviados\", function () {",
                  "    pm.expect(review.user_id).to.eql(1);",
                  "    pm.expect(review.article_id).to.eql(1);",
                  "    pm.expect(review.rating).to.eql(5);",
                  "    pm.expect(review.body).to.eql(\"Buena experiencia con el producto.\");",
                  "  });",
                  "}"
                ]
              }
            }
